# Todo es backend (funciones de /api). Nunca usar el prefijo VITE_: terminaría en el navegador.

# JSON de la clave de la cuenta de servicio, en base64: base64 -i clave.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=
# Solo el ID de la hoja: lo que va entre /d/ y /edit en su URL
GOOGLE_SHEET_ID=
# Contraseña para entrar a /admin, mínimo 12 caracteres
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión, mínimo 32 caracteres: openssl rand -base64 32
SESSION_SECRET=
