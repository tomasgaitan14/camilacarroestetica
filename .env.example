# Backend (funciones de /api). Nunca usar el prefijo VITE_ para secretos: terminaría en el navegador.

# JSON de la clave de la cuenta de servicio, en base64: base64 -i clave.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=
# Solo el ID de la hoja: lo que va entre /d/ y /edit en su URL
GOOGLE_SHEET_ID=
# Contraseña para entrar a /admin, mínimo 12 caracteres
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión, mínimo 32 caracteres: openssl rand -base64 32
SESSION_SECRET=

# --- Avisos por WhatsApp (opcional; sin WHATSAPP_MODE están apagados, como en producción) ---
# zernio-sandbox: simulación, todos los mensajes van a ZERNIO_TEST_PHONE por el sandbox de Zernio
WHATSAPP_MODE=
ZERNIO_API_KEY=
# Celular de prueba con sesión activa en el sandbox (con código de país, ej: +5491123456789)
ZERNIO_TEST_PHONE=
# Opcional; por defecto https://zernio.com/api/v1
ZERNIO_BASE_URL=
# Clave que manda GitHub Actions para disparar los recordatorios, mínimo 32 caracteres: openssl rand -base64 32
CRON_SECRET=

# --- Front (no es secreto: termina en el navegador) ---
# "true" muestra en /booking el aviso de que llegan mensajes por WhatsApp
VITE_WHATSAPP_NOTICE=
