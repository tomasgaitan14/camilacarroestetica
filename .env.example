# --- Frontend: todo lo que empieza con VITE_ termina en el bundle del navegador (nunca secretos) ---
VITE_SUPABASE_URL=https://zbapybnnzafascbkqmzr.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# --- Backend: funciones de /api (nunca con prefijo VITE_) ---
# JSON de la clave de la cuenta de servicio, en base64: base64 -i clave.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=
# Solo el ID de la hoja: lo que va entre /d/ y /edit en su URL
GOOGLE_SHEET_ID=
# ID del cliente OAuth web (termina en .apps.googleusercontent.com)
GOOGLE_OAUTH_CLIENT_ID=
# Emails que pueden entrar a /admin, separados por coma
ADMIN_EMAILS=
# Secreto para firmar la cookie de sesión, mínimo 32 caracteres: openssl rand -base64 32
SESSION_SECRET=
